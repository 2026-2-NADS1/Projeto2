        <mxCell id="ip_txt" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Principais Redes e Faixas de IP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DMZ (Servidores Públicos)&lt;/b&gt;&lt;br&gt;10.0.10.0/24&lt;br&gt;&amp;nbsp;&amp;nbsp;• Web: 10.0.10.10&lt;br&gt;&amp;nbsp;&amp;nbsp;• Banco de Dados: 10.0.10.11&lt;br&gt;&lt;br&gt;&lt;b&gt;LAN (Rede Interna)&lt;/b&gt;&lt;br&gt;192.168.1.0/24&lt;br&gt;&amp;nbsp;&amp;nbsp;• PCs: 192.168.1.10 – 192.168.1.50&lt;br&gt;&amp;nbsp;&amp;nbsp;• Notebooks: 192.168.1.51 – 192.168.1.70&lt;br&gt;&amp;nbsp;&amp;nbsp;• Móveis: 192.168.1.71 – 192.168.1.90&lt;br&gt;&amp;nbsp;&amp;nbsp;• Impressora: 192.168.1.100&lt;br&gt;&lt;br&gt;&lt;b&gt;Gateway (Firewall/Roteador)&lt;/b&gt;&lt;br&gt;192.168.1.1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
