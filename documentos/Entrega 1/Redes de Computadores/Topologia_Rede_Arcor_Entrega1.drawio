        <!-- CONSIDERAÇÕES -->
        <mxCell id="cons_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FD;strokeColor=#1E88E5;strokeWidth=2;arcSize=3;" vertex="1" parent="1">
